# ============================================================
# 多视觉融合的三维重建平台搭建 — .gitignore
# 技术栈：C++17 / CMake / OpenCV(CUDA) / Eigen / Ceres·g2o / PCL·VTK
#         辅助：Python（Open3D、图表脚本）
# ============================================================

# ------------------------------------------------------------
# 1. 构建目录与 CMake 产物
# ------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/
output/
bin/
lib/
install/
stage/
_deps/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
cmake_uninstall.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
Makefile
*.ninja
.ninja_deps
.ninja_log
compile_commands.json
*.cmake.stamp
CMakeScripts/

# 第三方库若以子模块/源码方式引入，其内部构建目录同样忽略
third_party/*/build/
third_party/*/install/

# ------------------------------------------------------------
# 2. 可执行文件与二进制产物
# ------------------------------------------------------------
*.exe
*.out
*.app
*.binaries
*.pyd

# ------------------------------------------------------------
# 3. 目标文件、静态库与调试符号
# ------------------------------------------------------------
*.o
*.obj
*.lo
*.a
*.lib
*.la
*.so
*.so.*
*.dylib
*.dll
*.pdb
*.ilk
*.exp
*.idb
*.gch
*.pch
*.tlog
*.iobj
*.ipdb

# 注：若需随仓库分发预编译的运行时 DLL（如 opencv_world4xx.dll），
# 请用 `git add -f <文件>` 单独强制加入。

# ------------------------------------------------------------
# 4. CUDA 中间产物
# ------------------------------------------------------------
*.cubin
*.fatbin
*.ptx
*.sass

# ------------------------------------------------------------
# 5. Visual Studio / VS Code
# ------------------------------------------------------------
.vs/
.vscode/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.aps
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
ipch/
*.ncb
*.psess
*.vsp

# ------------------------------------------------------------
# 6. Qt / PCL·VTK 可视化相关自动生成文件
# ------------------------------------------------------------
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qmake.stash
*.moc

# ------------------------------------------------------------
# 7. 运行期产物、日志与缓存
# ------------------------------------------------------------
logs/
log/
*.log
cache/
data/cache/
data/raw/
results/
runs/
run/

# 特征缓存 / 中间重建结果（体积大且可重算）
*.cache
reconstruction.json
*.bak

# 点云与网格的默认导出目录（示例数据请放 data/samples/ 并强制提交）
*.ply
*.pcd
*.stl
*.gltf
*.glb
*.obj

# 注：tests/ 或 data/ 下的少量标准样例（如 bunny.ply）用 `git add -f` 加入。

# ------------------------------------------------------------
# 8. 大数据集与演示素材
# ------------------------------------------------------------
datasets/
data/archive/
*.zip
*.7z
*.tar.gz

# ------------------------------------------------------------
# 9. Python 辅助工具
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.python-version
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ------------------------------------------------------------
# 10. 编辑器 / 操作系统 / 临时文件
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp
*.swo
*.tmp
*.temp
*.orig
*.rej
*.bak
*.autosave
.clangd/
.ccls-cache/
tags
TAGS
.directory

# ------------------------------------------------------------
# 11. 本机环境残留（不入库）
# ------------------------------------------------------------
_acl_recovery/
*.local
.env
.env.local

# ------------------------------------------------------------
# 12. 保留目录占位文件
# ------------------------------------------------------------
!**/.gitkeep
